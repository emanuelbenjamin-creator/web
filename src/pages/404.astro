---
import Base from '../layouts/Base.astro';
import Encabezado from '../components/Encabezado.astro';
import Pie from '../components/secciones/Pie.astro';
import WhatsApp from '../components/iconos/WhatsApp.astro';
import { enlaceWhatsApp } from '../datos/sitio';
---
<Base titulo="Página no encontrada | Automatiza Studio" descripcion="Esta página no existe.">
  <Encabezado />
  <main class="relative isolate overflow-hidden px-4 py-28 text-center md:py-40">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(50%_60%_at_50%_100%,rgb(var(--luz-1)/0.35),transparent_70%)]" aria-hidden="true"></div>
    <p class="font-titulo text-7xl font-semibold tracking-[-0.04em] text-acento-claro">404</p>
    <h1 class="mt-4 font-titulo text-4xl font-medium tracking-[-0.03em] sm:text-5xl">Esta página no existe</h1>
    <p class="mx-auto mt-4 max-w-md text-texto-2">Puede que el enlace esté mal escrito o que la página se haya movido. Desde el inicio encuentras todo.</p>
    <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="/" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-white px-6 font-semibold text-tinta">Volver al inicio</a>
      <a href={enlaceWhatsApp()} class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl border border-white/30 px-6 font-semibold hover:bg-white/5">
        <WhatsApp class="size-5" /> Escríbenos por WhatsApp
      </a>
    </div>
  </main>
  <Pie />
</Base>
