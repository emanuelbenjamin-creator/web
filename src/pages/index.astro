---
import Base from '../layouts/Base.astro';
import Encabezado from '../components/Encabezado.astro';
import FondoLuz from '../components/FondoLuz.astro';
import Portada from '../components/Portada.astro';
import Vitrina from '../components/Vitrina.astro';
import Tecnologias from '../components/Tecnologias.astro';
import Problema from '../components/secciones/Problema.astro';
import Proceso from '../components/secciones/Proceso.astro';
import Rubros from '../components/secciones/Rubros.astro';
import Demos from '../components/secciones/Demos.astro';
import Calculadora from '../components/secciones/Calculadora.astro';
import Datos from '../components/secciones/Datos.astro';
import Precios from '../components/secciones/Precios.astro';
import Testimonios from '../components/secciones/Testimonios.astro';
import Preguntas from '../components/secciones/Preguntas.astro';
import Contacto from '../components/secciones/Contacto.astro';
import Pie from '../components/secciones/Pie.astro';
import WhatsAppFlotante from '../components/WhatsAppFlotante.astro';
import { SITIO } from '../datos/sitio';
import { PREGUNTAS } from '../datos/preguntas';

// Datos estructurados para Google: la agencia y sus preguntas frecuentes
// (sin las que todavía tienen la respuesta pendiente).
const agencia = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITIO.nombre,
  url: SITIO.dominio,
  email: SITIO.correo,
  description: 'Agencia de automatización con IA: agentes de IA para WhatsApp, CRM, agenda automática, automatización de procesos e integración de sistemas.',
  areaServed: ['Perú', 'Latinoamérica', 'España', 'Estados Unidos'],
  address: { '@type': 'PostalAddress', addressCountry: 'PE' },
};
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: PREGUNTAS.filter((p) => !p.pendiente).map((p) => ({
    '@type': 'Question',
    name: p.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: p.respuesta },
  })),
};
---
<Base
  titulo="Automatiza Studio | Agencia de automatización con IA en Perú"
  descripcion="Agentes de IA para WhatsApp, CRM para pymes, automatización de procesos e integración de sistemas. Tu negocio responde, vende, agenda y se administra solo, las 24 horas."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(agencia)} />
    <script type="application/ld+json" set:html={JSON.stringify(faq)} />
  </Fragment>

  <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-tinta">Saltar al contenido</a>
  <Encabezado />
  <main id="contenido">
    <div class="relative isolate">
      <FondoLuz />
      <Portada />
      <Vitrina />
    </div>
    <Tecnologias />
    <Problema />
    <Proceso />
    <Rubros />
    <Demos />
    <Calculadora />
    <Datos />
    <Precios />
    <Testimonios />
    <Preguntas />
    <Contacto />
  </main>
  <Pie />
  <WhatsAppFlotante />
</Base>
