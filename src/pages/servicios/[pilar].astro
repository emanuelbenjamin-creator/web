---
// Página de cada pilar: /servicios/responde/, /servicios/vende/, etc.
import Pagina from '../../layouts/Pagina.astro';
import Migas from '../../components/Migas.astro';
import Acciones from '../../components/Acciones.astro';
import Beneficios from '../../components/Beneficios.astro';
import LlamadoFinal from '../../components/LlamadoFinal.astro';
import Pasos from '../../components/secciones/Pasos.astro';
import Preguntas from '../../components/secciones/Preguntas.astro';
import Flecha from '../../components/iconos/Flecha.astro';
import Responde from '../../components/vitrina/Responde.astro';
import Vende from '../../components/vitrina/Vende.astro';
import Agenda from '../../components/vitrina/Agenda.astro';
import Administra from '../../components/vitrina/Administra.astro';
import Conecta from '../../components/vitrina/Conecta.astro';
import { PILARES, SITIO, publicada } from '../../datos/sitio';
import { CONTENIDO_PILARES } from '../../datos/pilares';
import { RUBROS } from '../../datos/rubros';
import { es } from '../../i18n/es';

export function getStaticPaths() {
  return PILARES.map((p) => ({ params: { pilar: p.id }, props: { pilar: p } }));
}

const { pilar } = Astro.props;
const c = CONTENIDO_PILARES[pilar.id];
const vistas = { responde: Responde, vende: Vende, agenda: Agenda, administra: Administra, conecta: Conecta };
const Vista = vistas[pilar.id];
const plan = es.precios.planes.find((p) => p.id === c.plan)!;
const rubros = RUBROS.filter((r) => (r.pilares as readonly string[]).includes(pilar.nombre));
const otros = PILARES.filter((p) => p.id !== pilar.id);

const servicio = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: c.titulo,
  serviceType: pilar.nombre,
  description: c.seo.descripcion,
  provider: { '@type': 'ProfessionalService', name: SITIO.nombre, url: SITIO.dominio },
  areaServed: es.meta.areas,
};
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.preguntas.map((p) => ({ '@type': 'Question', name: p.pregunta, acceptedAnswer: { '@type': 'Answer', text: p.respuesta } })),
};
---
<Pagina titulo={c.seo.titulo} descripcion={c.seo.descripcion}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(servicio)} />
    <script type="application/ld+json" set:html={JSON.stringify(faq)} />
  </Fragment>

  <section class="relative isolate overflow-hidden border-b border-linea px-4 pt-10 pb-16 md:px-6 md:pt-14 md:pb-24">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(60%_70%_at_75%_10%,rgb(var(--luz-1)/0.35),transparent_70%),radial-gradient(40%_50%_at_10%_100%,rgb(var(--luz-3)/0.12),transparent_70%)]" aria-hidden="true"></div>
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[1fr_1.05fr] lg:gap-14">
      <div>
        <Migas items={[{ texto: 'Inicio', href: '/' }, { texto: 'Servicios', href: '/#servicios' }, { texto: pilar.nombre }]} />
        <p class="mt-8 text-sm font-semibold text-acento-claro">{pilar.nombre} · {pilar.lema}</p>
        <h1 class="mt-3 font-titulo text-[2.5rem] leading-[1.04] font-medium tracking-[-0.035em] text-balance sm:text-6xl">{c.titulo}</h1>
        <p class="mt-6 max-w-xl text-lg text-texto-2">{c.bajada}</p>
        <div class="mt-9"><Acciones /></div>
      </div>
      <Vista />
    </div>
  </section>

  <Beneficios titulo="Qué incluye" items={c.incluye} />
  <Pasos titulo="Cómo funciona" pasos={c.pasos} />

  {rubros.length > 0 && (
    <section class="border-t border-linea px-4 py-20 md:px-6 md:py-28" aria-labelledby="titulo-ideal">
      <div class="mx-auto max-w-6xl">
        <h2 id="titulo-ideal" class="font-titulo text-[2.1rem] leading-[1.06] font-medium tracking-[-0.03em] sm:text-5xl">Ideal para</h2>
        <p class="mt-4 max-w-xl text-texto-2">Ejemplos de cómo lo usan distintos rubros.</p>
        <ul class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {rubros.map((r) => {
            const ruta = `/rubros/${r.id}/`;
            const Contenedor = publicada(ruta) ? 'a' : 'div';
            return (
              <li>
                <Contenedor href={publicada(ruta) ? ruta : undefined} class="group flex h-full flex-col rounded-2xl border border-white/10 bg-tarjeta p-6 transition-colors hover:border-white/25">
                  <h3 class="font-titulo text-xl font-medium tracking-tight">{r.nombre}</h3>
                  <p class="mt-3 flex-1 text-texto-2">{r.ahora}</p>
                  {publicada(ruta) && <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-acento-claro">Ver el caso <Flecha /></span>}
                </Contenedor>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <section class="border-t border-linea px-4 py-20 md:px-6 md:py-28" aria-labelledby="titulo-plan">
    <div class="mx-auto grid max-w-6xl items-center gap-10 rounded-[24px] border border-[rgb(var(--luz-1)/0.6)] bg-[radial-gradient(100%_80%_at_100%_0%,rgb(var(--luz-1)/0.25),transparent_65%)] bg-tarjeta p-7 sm:p-10 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <p class="text-sm font-semibold text-acento-claro">Plan recomendado</p>
        <h2 id="titulo-plan" class="mt-2 font-titulo text-3xl font-medium tracking-tight sm:text-4xl">{plan.nombre}</h2>
        <p class="mt-2 text-texto-2">{plan.resumen}</p>
        <p class="mt-6 text-sm text-tenue">Implementación desde</p>
        <p class="font-titulo text-[2.6rem] leading-none font-semibold tracking-[-0.03em]">{plan.precio.pen}</p>
        <p class="mt-2 text-texto-2">+ {plan.mensual.pen} · {plan.plazo}</p>
        <p class="mt-4 text-sm text-tenue">Precios en soles sin IGV. La propuesta exacta llega en 48 horas, después del diagnóstico.</p>
      </div>
      <div class="flex flex-col gap-3 lg:items-end">
        <Acciones />
        <a href={publicada('/precios/') ? '/precios/' : '/#precios'} class="inline-flex min-h-11 items-center gap-2 font-semibold text-acento-claro hover:underline">Ver todos los planes <Flecha /></a>
      </div>
    </div>
  </section>

  <Preguntas lista={c.preguntas} titulo={`Preguntas sobre ${pilar.nombre}`} bajada="" />

  <LlamadoFinal />

  <nav class="border-t border-linea px-4 py-14 md:px-6" aria-labelledby="titulo-otros">
    <div class="mx-auto max-w-6xl">
      <h2 id="titulo-otros" class="text-sm font-semibold text-tenue">Los otros pilares</h2>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {otros.map((o) => (
          <li>
            <a href={publicada(o.ruta) ? o.ruta : '/#servicios'} class="flex h-full items-center justify-between gap-3 rounded-2xl border border-white/10 px-5 py-4 transition-colors hover:border-white/25 hover:bg-white/[0.03]">
              <span>
                <span class="block font-titulo text-lg font-medium">{o.nombre}</span>
                <span class="block text-sm text-texto-2">{o.lema}</span>
              </span>
              <Flecha class="size-4 shrink-0 text-acento-claro" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</Pagina>
