---
import { enlaceAgenda } from '../../datos/sitio';
// Valores iniciales: 15 horas a la semana a S/ 15 la hora.
---
<section id="calculadora" class="border-t border-linea px-4 py-20 md:px-6 md:py-28" aria-labelledby="titulo-calculadora">
  <div class="mx-auto max-w-6xl">
    <h2 id="titulo-calculadora" class="max-w-3xl font-titulo text-[2.1rem] leading-[1.06] font-medium tracking-[-0.03em] text-balance sm:text-5xl">
      ¿Cuánto te cuestan las tareas repetitivas?
    </h2>
    <p class="mt-4 max-w-xl text-texto-2">Mueve los valores y mira cuánto dinero se va cada mes en trabajo que se puede automatizar.</p>

    <div class="mt-12 grid overflow-hidden rounded-[24px] border border-white/10 lg:grid-cols-2" data-calculadora>
      <form class="space-y-9 bg-tarjeta p-6 sm:p-10" onsubmit="return false">
        <div>
          <div class="flex items-baseline justify-between gap-4">
            <label for="calc-horas" class="font-semibold">Horas a la semana en tareas repetitivas</label>
            <span class="shrink-0 font-titulo text-2xl font-medium"><output for="calc-horas" data-ver-horas>15</output> h</span>
          </div>
          <p class="mt-1 text-sm text-tenue" id="ayuda-horas">Responder mensajes, armar reportes, copiar datos, confirmar citas…</p>
          <input
            id="calc-horas"
            type="range"
            min="1"
            max="80"
            step="1"
            value="15"
            aria-describedby="ayuda-horas"
            class="mt-5 h-2 w-full cursor-pointer appearance-none rounded-full bg-white/10 accent-[var(--ac)]"
            data-horas
          />
          <div class="mt-2 flex justify-between text-xs text-tenue" aria-hidden="true"><span>1 h</span><span>80 h</span></div>
        </div>

        <div>
          <label for="calc-costo" class="font-semibold">Costo por hora de quien las hace</label>
          <p class="mt-1 text-sm text-tenue" id="ayuda-costo">Sueldo mensual ÷ horas trabajadas al mes. Si no lo sabes, deja el valor de ejemplo.</p>
          <div class="mt-4 flex max-w-[14rem] items-center rounded-xl border border-white/15 bg-fondo focus-within:border-acento-claro">
            <span class="pl-4 text-texto-2" aria-hidden="true">S/</span>
            <input
              id="calc-costo"
              type="number"
              inputmode="decimal"
              min="1"
              max="1000"
              step="0.5"
              value="15"
              aria-describedby="ayuda-costo"
              class="min-h-12 w-full bg-transparent px-3 font-titulo text-xl outline-none"
              data-costo
            />
          </div>
        </div>
      </form>

      <div class="relative flex flex-col justify-between gap-10 bg-[radial-gradient(120%_90%_at_100%_0%,rgb(var(--luz-1)/0.45),transparent_60%),radial-gradient(90%_70%_at_0%_100%,rgb(var(--luz-3)/0.18),transparent_60%)] bg-superficie p-6 sm:p-10">
        <div aria-live="polite">
          <p class="text-texto-2">Estás dejando ir</p>
          <p class="mt-1 font-titulo text-6xl leading-none font-semibold tracking-[-0.04em] sm:text-7xl" data-mes>S/ 975</p>
          <p class="mt-2 text-lg text-texto-2">al mes</p>
          <dl class="mt-8 grid grid-cols-2 gap-6 border-t border-white/10 pt-6">
            <div>
              <dt class="text-sm text-tenue">Al año</dt>
              <dd class="mt-1 font-titulo text-2xl font-medium" data-anio>S/ 11,700</dd>
            </div>
            <div>
              <dt class="text-sm text-tenue">Jornadas de 8 horas al mes</dt>
              <dd class="mt-1 font-titulo text-2xl font-medium" data-jornadas>8</dd>
            </div>
          </dl>
        </div>
        <div>
          <a
            href={enlaceAgenda()}
            class="inline-flex min-h-12 w-full items-center justify-center rounded-xl bg-white px-6 font-semibold text-tinta transition-transform duration-150 hover:-translate-y-0.5 sm:w-auto"
          >
            Agenda tu diagnóstico gratis
          </a>
          <p class="mt-4 text-xs text-tenue">Cálculo referencial: horas por semana × costo por hora × 52 semanas ÷ 12 meses.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const formato = new Intl.NumberFormat('es-PE', { style: 'currency', currency: 'PEN', maximumFractionDigits: 0 });
  document.querySelectorAll<HTMLElement>('[data-calculadora]').forEach((calc) => {
    const horas = calc.querySelector<HTMLInputElement>('[data-horas]')!;
    const costo = calc.querySelector<HTMLInputElement>('[data-costo]')!;
    const ver = (sel: string) => calc.querySelector<HTMLElement>(sel)!;
    const calcular = () => {
      const h = Math.min(80, Math.max(0, Number(horas.value) || 0));
      const c = Math.min(1000, Math.max(0, Number(costo.value) || 0));
      const mes = (h * c * 52) / 12;
      ver('[data-ver-horas]').textContent = String(h);
      ver('[data-mes]').textContent = formato.format(mes);
      ver('[data-anio]').textContent = formato.format(h * c * 52);
      ver('[data-jornadas]').textContent = String(Math.round((h * 52) / 12 / 8));
    };
    horas.addEventListener('input', calcular);
    costo.addEventListener('input', calcular);
    calcular();
  });
</script>
