---
import { PREGUNTAS } from '../../datos/preguntas';
---
<section id="preguntas" class="border-t border-linea px-4 py-20 md:px-6 md:py-28" aria-labelledby="titulo-preguntas">
  <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div>
      <h2 id="titulo-preguntas" class="font-titulo text-[2.1rem] leading-[1.06] font-medium tracking-[-0.03em] sm:text-5xl">Preguntas frecuentes</h2>
      <p class="mt-4 max-w-sm text-texto-2">¿Tienes otra duda? Escríbenos por WhatsApp y te respondemos.</p>
    </div>
    <div class="divide-y divide-linea border-y border-linea">
      {PREGUNTAS.map((p) => (
        <details class="group">
          <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-6 py-5 text-lg font-semibold [&::-webkit-details-marker]:hidden">
            {p.pregunta}
            <span class="relative size-5 shrink-0 text-acento-claro" aria-hidden="true">
              <span class="absolute top-1/2 left-0 h-0.5 w-5 -translate-y-1/2 rounded bg-current"></span>
              <span class="absolute top-0 left-1/2 h-5 w-0.5 -translate-x-1/2 rounded bg-current transition-transform duration-200 group-open:rotate-90 group-open:opacity-0"></span>
            </span>
          </summary>
          <p class="pb-6 text-texto-2">{p.respuesta}</p>
        </details>
      ))}
    </div>
  </div>
</section>
