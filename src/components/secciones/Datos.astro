---
// Solo los datos que entregó Automatiza Studio, con su fuente.
import { textos } from '../../i18n';
const d = textos(Astro.currentLocale).datos;
---
<section class="bg-papel px-4 py-20 text-tinta md:px-6 md:py-28" aria-labelledby="titulo-datos">
  <div class="mx-auto max-w-6xl">
    <h2 id="titulo-datos" class="max-w-3xl font-titulo text-[2.1rem] leading-[1.06] font-medium tracking-[-0.03em] text-balance sm:text-5xl">{d.titulo}</h2>

    <div class="mt-12 grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
      <figure class="self-start rounded-[24px] bg-white p-8 shadow-[0_20px_60px_-30px_rgb(10_11_20/0.35)] sm:p-10 lg:sticky lg:top-28">
        <p class="font-titulo text-[5.5rem] leading-none font-semibold tracking-[-0.05em] text-acento sm:text-[7rem]">{d.destacado.cifra}</p>
        <p class="mt-4 text-lg text-tinta-2">{d.destacado.texto}</p>
        <p class="mt-6 font-titulo text-2xl font-medium tracking-tight">{d.destacado.frase}</p>
        <figcaption class="mt-6 text-xs text-tinta-3">{d.fuente} {d.destacado.fuente}</figcaption>
      </figure>

      <div>
        {d.grupos.map((g, gi) => (
          <>
            <h3 class:list={['text-sm font-semibold text-tinta-3', gi > 0 && 'mt-8']}>{g.titulo}</h3>
            <ul class="mt-2 grid sm:grid-cols-2 sm:gap-x-10">
              {g.lista.map((x) => (
                <li class="border-t border-tinta/12 py-6">
                  <p class="font-titulo text-4xl font-semibold tracking-[-0.03em] text-acento">{x.cifra}</p>
                  <p class="mt-2 text-tinta-2">{x.texto}</p>
                  <p class="mt-2 text-xs text-tinta-3">{d.fuente} {x.fuente}</p>
                </li>
              ))}
            </ul>
          </>
        ))}
      </div>
    </div>
  </div>
</section>
