---
import Check from '../iconos/Check.astro';
import { enlaceAgenda } from '../../datos/sitio';

// Precios "desde". Soles sin IGV; dólares para empresas fuera de Perú.
const planes = [
  {
    nombre: 'Plan Responde',
    resumen: 'Agente de IA para WhatsApp y redes.',
    precio: { pen: 'S/1,500', usd: 'US$500' },
    mensual: { pen: 'desde S/250 al mes', usd: 'mantenimiento desde US$150 al mes' },
    plazo: 'Listo en 1 a 2 semanas',
    incluye: [
      'Agente de IA para WhatsApp, Instagram y Facebook',
      'Entrenado con la información de tu negocio',
      'Toma pedidos y califica a los interesados',
      'Pasa la conversación a una persona cuando hace falta',
    ],
  },
  {
    nombre: 'Plan Vende y Agenda',
    resumen: 'Agente de IA + CRM + seguimiento + agenda.',
    precio: { pen: 'S/3,500', usd: 'US$1,200' },
    mensual: { pen: 'desde S/450 al mes', usd: 'mantenimiento desde US$150 al mes' },
    plazo: 'Listo en 2 a 3 semanas',
    destacado: true,
    incluye: [
      'Todo lo del Plan Responde',
      'CRM con embudo de ventas',
      'Seguimiento automático por WhatsApp y correo',
      'Reservas, confirmaciones y recordatorios en tu calendario',
    ],
  },
  {
    nombre: 'Plan Empresa Automática',
    resumen: 'Procesos, sistemas conectados y asistente interno.',
    precio: { pen: 'S/6,000', usd: 'US$2,500' },
    mensual: { pen: 'cotización a medida', usd: 'mantenimiento desde US$150 al mes' },
    plazo: 'Plazo según el alcance',
    incluye: [
      'Procesos administrativos automáticos',
      'Integración de tus sistemas: CRM, ERP, facturación, tienda',
      'Asistente de IA con la información de tu empresa',
      'Cotización a medida',
    ],
  },
];
---
<section id="precios" class="px-4 py-20 md:px-6 md:py-28" aria-labelledby="titulo-precios">
  <div class="mx-auto max-w-6xl" data-precios>
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <h2 id="titulo-precios" class="font-titulo text-[2.1rem] leading-[1.06] font-medium tracking-[-0.03em] sm:text-5xl">Planes y precios</h2>
        <p class="mt-4 max-w-xl text-texto-2">Precios desde, para que sepas por dónde empezar. Tu propuesta exacta llega en 48 horas, después del diagnóstico.</p>
      </div>
      <div class="inline-flex rounded-xl border border-white/15 p-1 text-sm" role="group" aria-label="Moneda">
        <button type="button" class="min-h-10 rounded-lg px-4 font-semibold transition-colors aria-pressed:bg-white aria-pressed:text-tinta" aria-pressed="true" data-moneda="pen">Perú (S/)</button>
        <button type="button" class="min-h-10 rounded-lg px-4 font-semibold text-texto-2 transition-colors aria-pressed:bg-white aria-pressed:text-tinta" aria-pressed="false" data-moneda="usd">Otros países (US$)</button>
      </div>
    </div>

    <ul class="mt-12 grid gap-5 lg:grid-cols-3 lg:items-stretch">
      {planes.map((p) => (
        <li
          class:list={[
            'relative flex flex-col rounded-[24px] p-7 sm:p-8',
            p.destacado
              ? 'border border-[rgb(var(--luz-1)/0.8)] bg-[radial-gradient(120%_60%_at_50%_0%,rgb(var(--luz-1)/0.28),transparent_70%)] bg-tarjeta shadow-[0_30px_90px_-40px_rgb(var(--luz-1)/0.9)]'
              : 'border border-white/10 bg-tarjeta',
          ]}
        >
          {p.destacado && (
            <span class="absolute -top-3.5 left-7 rounded-full bg-acento px-3 py-1 text-xs font-semibold text-sobre-acento">El más elegido</span>
          )}
          <h3 class="font-titulo text-2xl font-medium tracking-tight">{p.nombre}</h3>
          <p class="mt-1 text-texto-2 lg:min-h-[3.4rem]">{p.resumen}</p>
          <p class="mt-7 text-sm text-tenue">Implementación desde</p>
          <p class="font-titulo text-[2.6rem] leading-none font-semibold tracking-[-0.03em]">
            <span data-pen>{p.precio.pen}</span><span data-usd hidden>{p.precio.usd}</span>
          </p>
          <p class="mt-2 text-texto-2">
            + <span data-pen>{p.mensual.pen}</span><span data-usd hidden>{p.mensual.usd}</span>
          </p>
          <p class="mt-4 inline-flex w-fit rounded-full bg-white/[0.07] px-3 py-1 text-sm font-medium">{p.plazo}</p>
          <ul class="mt-7 space-y-3 border-t border-white/10 pt-6 text-[0.97rem]">
            {p.incluye.map((i) => (
              <li class="flex gap-2.5"><Check class="mt-0.5 size-5 shrink-0 text-acento-claro" />{i}</li>
            ))}
          </ul>
          <div class="mt-auto pt-8">
            <a
              href={enlaceAgenda()}
              class:list={[
                'inline-flex min-h-12 w-full items-center justify-center rounded-xl px-6 font-semibold transition-[filter,transform] duration-150 hover:-translate-y-0.5',
                p.destacado ? 'bg-acento text-sobre-acento hover:brightness-110' : 'border border-white/25 hover:bg-white/5',
              ]}
            >
              Agenda tu diagnóstico gratis
            </a>
          </div>
        </li>
      ))}
    </ul>

    <div class="mt-10 grid gap-6 text-sm text-texto-2 md:grid-cols-2">
      <ul class="space-y-2">
        <li><span data-pen>Precios en soles sin IGV.</span><span data-usd hidden>Precios en dólares para empresas fuera de Perú.</span></li>
        <li>La mensualidad incluye soporte, servidor y mejoras.</li>
      </ul>
      <p>
        Lo que cobra Meta por los mensajes de WhatsApp va aparte: cada número tiene un cupo gratuito de mensajes de atención
        al mes y, pasado ese cupo, Meta cobra por mensaje según su tarifa. Las campañas masivas también se pagan a Meta.
        <span class="text-tenue">{' '}[VERIFICAR TARIFA VIGENTE DE META]</span>
      </p>
    </div>

    <div class="mt-10 flex flex-col items-start justify-between gap-5 rounded-2xl border border-white/10 bg-superficie p-6 sm:flex-row sm:items-center sm:p-8">
      <p class="font-titulo text-xl font-medium tracking-tight sm:text-2xl">Empieza con un diagnóstico gratis de 30 minutos y recibe tu propuesta en 48 horas.</p>
      <a href={enlaceAgenda()} class="inline-flex min-h-12 shrink-0 items-center justify-center rounded-xl bg-white px-6 font-semibold text-tinta transition-transform duration-150 hover:-translate-y-0.5">
        Agenda tu diagnóstico gratis
      </a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-precios]').forEach((bloque) => {
    const botones = [...bloque.querySelectorAll<HTMLButtonElement>('[data-moneda]')];
    botones.forEach((boton) =>
      boton.addEventListener('click', () => {
        const moneda = boton.dataset.moneda;
        botones.forEach((b) => {
          b.setAttribute('aria-pressed', String(b === boton));
          b.classList.toggle('text-texto-2', b !== boton);
        });
        bloque.querySelectorAll<HTMLElement>('[data-pen]').forEach((e) => (e.hidden = moneda !== 'pen'));
        bloque.querySelectorAll<HTMLElement>('[data-usd]').forEach((e) => (e.hidden = moneda !== 'usd'));
      }),
    );
  });
</script>
