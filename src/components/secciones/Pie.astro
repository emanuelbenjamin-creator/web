---
import { PILARES, SITIO, enlaceWhatsApp, pendiente } from '../../datos/sitio';

const columnas = [
  { titulo: 'Servicios', enlaces: PILARES.map((p) => ({ texto: p.nombre, href: p.ruta })) },
  { titulo: 'Empresa', enlaces: [
    { texto: 'Nosotros', href: '/nosotros/' },
    { texto: 'Precios', href: '/#precios' },
    { texto: 'Blog', href: '/blog/' },
    { texto: 'Contacto', href: '/#contacto' },
  ] },
  { titulo: 'Legal', enlaces: [
    { texto: 'Política de Privacidad', href: '/privacidad/' },
    { texto: 'Términos', href: '/terminos/' },
    { texto: 'Libro de Reclamaciones', href: '/libro-de-reclamaciones/' },
  ] },
];
const redes = [
  { texto: 'Instagram', valor: SITIO.instagram, href: `https://instagram.com/${SITIO.instagram.replace('@', '')}` },
  { texto: 'LinkedIn', valor: SITIO.linkedin, href: SITIO.linkedin },
];
---
<footer class="border-t border-linea px-4 pt-16 pb-28 md:px-6 md:pb-16">
  <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1.2fr_2fr]">
    <div>
      <a href="/" class="inline-flex items-baseline gap-2 font-titulo text-xl tracking-tight" aria-label="Automatiza Studio, inicio">
        <span class="font-bold">Automatiza</span>
        <span class="h-4 w-px self-center bg-texto/25" aria-hidden="true"></span>
        <span class="text-texto-2">Studio</span>
      </a>
      <p class="mt-3 font-titulo text-lg text-texto/90">Tu negocio, en automático.</p>
      <ul class="mt-6 space-y-2 text-texto-2">
        <li><a href={`mailto:${SITIO.correo}`} class="hover:text-texto">{SITIO.correo}</a></li>
        <li><a href={enlaceWhatsApp()} class="hover:text-texto">WhatsApp {SITIO.whatsapp}</a></li>
        <li>{SITIO.ciudad}, Perú · Atención 100% remota</li>
      </ul>
      <ul class="mt-6 flex flex-wrap gap-3 text-sm">
        {redes.map((r) =>
          pendiente(r.valor) ? (
            <li class="rounded-full border border-white/15 px-3 py-1.5 text-tenue">{r.texto} {r.valor}</li>
          ) : (
            <li><a href={r.href} class="inline-flex rounded-full border border-white/15 px-3 py-1.5 hover:border-white/40" rel="noopener">{r.texto}</a></li>
          ),
        )}
      </ul>
    </div>
    <nav class="grid grid-cols-2 gap-8 sm:grid-cols-3" aria-label="Pie de página">
      {columnas.map((c) => (
        <div>
          <h2 class="text-sm font-semibold text-tenue">{c.titulo}</h2>
          <ul class="mt-4 space-y-1">
            {c.enlaces.map((e) => <li><a href={e.href} class="inline-flex min-h-9 items-center text-texto-2 hover:text-texto">{e.texto}</a></li>)}
          </ul>
        </div>
      ))}
    </nav>
  </div>
  <div class="mx-auto mt-14 flex max-w-6xl flex-wrap justify-between gap-4 border-t border-linea pt-6 text-sm text-tenue">
    <p>© 2026 Automatiza Studio. Todos los derechos reservados.</p>
    <p>Hecho en Perú para el mundo.</p>
  </div>
</footer>
