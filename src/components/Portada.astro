---
import WhatsApp from './iconos/WhatsApp.astro';
import Check from './iconos/Check.astro';
import { enlaceAgenda, enlaceWhatsApp } from '../datos/sitio';
import { ancla, textos } from '../i18n';

const t = textos(Astro.currentLocale);
const p = t.portada;
const respaldo = ancla(t, 'contacto');
---
<section class="relative px-4 pt-14 pb-12 text-center sm:pt-20 md:pt-24 md:pb-16">
  <h1 class="aparecer mx-auto max-w-[15ch] font-titulo text-[2.85rem] leading-[1.02] font-medium tracking-[-0.035em] text-balance sm:text-6xl md:text-7xl lg:text-[5.4rem]">
    {p.titulo}
  </h1>
  <p class="aparecer mx-auto mt-6 max-w-xl text-lg text-texto/90 [animation-delay:80ms] md:text-xl">{p.bajada}</p>

  <div class="aparecer mt-9 flex flex-col items-center justify-center gap-3 [animation-delay:160ms] sm:flex-row">
    <a
      href={enlaceAgenda(respaldo)}
      class="inline-flex min-h-13 w-full items-center justify-center rounded-xl bg-white px-7 font-semibold text-tinta shadow-[0_10px_30px_-10px_rgb(0_0_0/0.6)] transition-transform duration-150 ease-out hover:-translate-y-0.5 active:translate-y-0 sm:w-auto"
    >
      {t.comun.agendar}
    </a>
    <a
      href={enlaceWhatsApp(p.mensajeProbar, respaldo)}
      class="inline-flex min-h-13 w-full items-center justify-center gap-2 rounded-xl border border-white/30 bg-white/5 px-6 font-semibold backdrop-blur-sm transition-colors hover:border-white/60 hover:bg-white/10 sm:w-auto"
    >
      <WhatsApp class="size-5" />
      <span>{p.probar}<span class="max-[420px]:sr-only">{p.probarCola}</span></span>
    </a>
  </div>
  <p class="aparecer mx-auto mt-4 max-w-xl text-sm text-texto/75 [animation-delay:200ms]">{p.micro}</p>

  <ul class="aparecer mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-[0.95rem] font-medium [animation-delay:260ms]">
    {p.garantias.map((g) => (
      <li class="flex items-center gap-1.5"><Check class="size-5 text-acento-claro" />{g}</li>
    ))}
  </ul>
</section>
