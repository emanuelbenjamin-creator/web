---
import Ventana from './Ventana.astro';
import { textos } from '../../i18n';
const v = textos(Astro.currentLocale).vitrina.vistas.responde;
---
<Ventana titulo={v.titulo} puntos={v.puntos}>
  <ol class="flex flex-col gap-2.5 text-[0.92rem] leading-snug">
    {v.mensajes.map((m, i) => (
      <li
        class:list={[
          'aparecer max-w-[85%] rounded-2xl px-3.5 py-2.5',
          m.de === 'cliente'
            ? 'self-start rounded-bl-md bg-superficie-2'
            : 'self-end rounded-br-md border border-[rgb(var(--luz-1)/0.45)] bg-[rgb(var(--luz-1)/0.18)]',
        ]}
        style={`animation-delay:${i * 180}ms`}
      >
        <span class="sr-only">{m.de === 'cliente' ? v.cliente : v.agente}</span>
        {m.texto}
        <span class="mt-1 block text-right text-[0.7rem] text-texto-2">{m.hora}{m.de === 'agente' && v.alInstante}</span>
      </li>
    ))}
  </ol>
</Ventana>
