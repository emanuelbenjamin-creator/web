---
import Ventana from './Ventana.astro';
import { textos } from '../../i18n';
const v = textos(Astro.currentLocale).vitrina.vistas.conecta;
---
<Ventana titulo={v.titulo} puntos={v.puntos}>
  <ol class="relative space-y-3 pl-7 text-[0.9rem]">
    <span class="absolute top-2 bottom-2 left-[0.55rem] w-px bg-white/15" aria-hidden="true">
      <span class="conecta__pulso absolute -left-[3px] size-[7px] rounded-full bg-acento-claro"></span>
    </span>
    {v.pasos.map((p, i) => (
      <li class="aparecer relative" style={`animation-delay:${i * 120}ms`}>
        <span class="absolute top-[0.35rem] -left-[1.6rem] size-3 rounded-full border-2 border-acento-claro bg-superficie" aria-hidden="true"></span>
        {p}
      </li>
    ))}
  </ol>
  <p class="mt-4 text-[0.75rem] text-texto-2">{v.nota}</p>
</Ventana>

<style>
  .conecta__pulso {
    animation: bajar 3.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  @keyframes bajar {
    from { top: 0; opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    to { top: 100%; opacity: 0; }
  }
</style>
