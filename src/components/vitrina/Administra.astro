---
import Ventana from './Ventana.astro';

const filas = [
  { que: 'Facturas leídas hoy', valor: '37' },
  { que: 'Cobranzas recordadas', valor: '5' },
  { que: 'Productos con poco stock', valor: '3' },
];
const barras = [40, 55, 48, 70, 62, 85, 74];
---
<Ventana titulo="Reporte automático · 20:00" puntos={['Lee facturas y comprobantes', 'Reportes que llegan solos', 'Alertas de stock y cobranzas']}>
  <div class="max-w-sm rounded-2xl rounded-tl-md bg-superficie-2 p-4 text-[0.88rem]">
    <p class="font-semibold">Resumen de hoy</p>
    <p class="text-[0.78rem] text-texto-2">Ventas de la semana</p>
    <div class="mt-3 flex h-16 items-end gap-1.5" aria-hidden="true">
      {barras.map((b, i) => (
        <span class:list={['flex-1 rounded-t-[4px]', i === barras.length - 1 ? 'bg-acento-claro' : 'bg-white/20']} style={`height:${b}%`}></span>
      ))}
    </div>
    <dl class="mt-4 space-y-1.5">
      {filas.map((f) => (
        <div class="flex justify-between gap-4 border-t border-white/10 pt-1.5">
          <dt class="text-texto-2">{f.que}</dt>
          <dd class="font-semibold tabular-nums">{f.valor}</dd>
        </div>
      ))}
    </dl>
  </div>
  <p class="mt-3 text-[0.75rem] text-texto-2">Llega solo por WhatsApp o correo, todos los días.</p>
</Ventana>
