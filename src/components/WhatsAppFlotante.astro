---
import WhatsApp from './iconos/WhatsApp.astro';
import { enlaceWhatsApp } from '../datos/sitio';
import { ancla, textos } from '../i18n';
const t = textos(Astro.currentLocale);
---
<a
  href={enlaceWhatsApp(t.comun.mensajeWhatsApp, ancla(t, 'contacto'))}
  class="fixed right-4 bottom-4 z-50 inline-flex size-14 items-center justify-center rounded-full bg-whatsapp text-white shadow-[0_12px_30px_-8px_rgb(0_0_0/0.6)] transition-transform duration-150 hover:scale-105 md:right-6 md:bottom-6"
  aria-label={t.comun.escribenos}
  data-no-imprimir
>
  <WhatsApp class="size-7" />
</a>
